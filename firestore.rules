rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(myEmail());
    }
    function isMember() {
      return signedIn() && exists(memberPath());
    }
    function role() {
      return get(memberPath()).data.role;
    }

    // Access list. The document id is the lower-case email address.
    match /members/{email} {
      allow read: if signedIn() && (myEmail() == email || (isMember() && role() == 'admin'));
      allow write: if isMember() && role() == 'admin';
    }

    // Opportunities.
    match /deals/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && role() in ['admin', 'editor'];
      allow delete: if isMember() && role() == 'admin';
    }
  }
}
